---
import Base from "../layouts/Base.astro";
---

<Base title="Book a Consultation - Shepparton Home Organising" description="Request a 30-minute consultation with HomeOrg. Tell us about your organising needs in Shepparton, the Goulburn Valley or Northern Victoria.">
  <section class="contact page">
    <div class="container narrow">
      <h1>Book a 30-minute Consultation</h1>
      <p>
        Tell us about your space and choose a preferred date. We'll get in touch
        to arrange your 30-minute consultation.
      </p>

      <form
        id="booking-form"
        class="booking-form"
        name="contact"
        method="POST"
        action="/.netlify/functions/send-email"
      >
        <div class="grid-2">
          <label>
            Name
            <input type="text" name="name" autocomplete="name" maxlength="120" required />
          </label>
          <label>
            Email
            <input type="email" name="email" autocomplete="email" maxlength="254" required />
          </label>
        </div>

        <div class="grid-2">
          <label>
            Phone
            <input type="tel" name="phone" autocomplete="tel" maxlength="40" required />
          </label>
          <label>
            Address
            <input type="text" name="address" autocomplete="street-address" maxlength="300" required />
          </label>
        </div>

        <div class="grid-2">
          <label>
            Preferred method of contact
            <select name="contact_method" required>
              <option value="">Select an option</option>
              <option value="Phone">Phone</option>
              <option value="Email">Email</option>
              <option value="SMS">SMS</option>
            </select>
          </label>

          <label>
            How did you find us?
            <select name="referral_source" required>
              <option value="">Select an option</option>
              <option value="Google">Google</option>
              <option value="Website">Website</option>
              <option value="Facebook">Facebook</option>
              <option value="Instagram">Instagram</option>
              <option value="Friend/Family">Friend / Family</option>
              <option value="Referral (NDIS/Agency)"
                >Referral (NDIS / Agency)</option
              >
              <option value="Other">Other</option>
            </select>
          </label>
        </div>

        <fieldset class="service-fieldset">
          <legend>Which service(s) are you interested in?</legend>

          <div class="service-chips">
            <button type="button" class="chip" data-value="Home Decluttering">
              Home Decluttering
            </button>
            <button
              type="button"
              class="chip"
              data-value="Practical Organising"
            >
              Practical Organising
            </button>
            <button
              type="button"
              class="chip"
              data-value="Homeshare and Co-living"
            >
              Homeshare & Co-living
            </button>
            <button
              type="button"
              class="chip"
              data-value="Moving Houses & Setting Up"
            >
              Moving Houses & Setting Up
            </button>
            <button
              type="button"
              class="chip"
              data-value="Staging to Sell/Lease"
            >
              Staging to Sell / Lease
            </button>
            <button
              type="button"
              class="chip"
              data-value="Not sure yet"
              data-default="true"
            >
              Not sure yet
            </button>
          </div>

          <!-- hidden input to submit values -->
          <input type="hidden" name="services" id="servicesInput" />
        </fieldset>

        <label>
          Brief notes (optional)
          <textarea
            name="message"
            rows="5"
            maxlength="4000"
            placeholder="Describe in a few words the space requiring organisation"
          ></textarea>
        </label>

        <div class="grid-2">
          <label
            >Consultation preferred date
            <input
              type="date"
              id="booking-date"
              name="booking_date"
              required
              placeholder="Choose a date"
              autocomplete="off"
            />
          </label>
        </div>

        <div hidden aria-hidden="true"><label>Leave blank<input name="website" tabindex="-1" autocomplete="off" /></label></div>
        <button class="btn" id="book-btn" type="submit" disabled
          >Book consultation</button
        >

        <p class="muted small">
          This sends a consultation request. We'll confirm the date and time with
          you before an appointment is booked.
        </p>
        <p class="muted small">
          This is a judgement-free service. Your privacy is always respected.
        </p>
        <p id="enquiry-status" role="status" aria-live="polite" aria-atomic="true" tabindex="-1"></p>
        <p class="muted small">You can also <a href="tel:+61415640352">call 0415 640 352</a> or <a href="mailto:roweedelgado@homeorg.com.au">email Rowee</a>.</p>
        <noscript>Please enable JavaScript to use this form, or contact us directly using the details above.</noscript>
      </form>
    </div>
  </section>

  <!-- Toast notifications (re-use your existing styles/behavior) -->
  <div id="toast" aria-hidden="true"></div>

  <!-- Calendar (Flatpickr) -->
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css"
  />
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/dark.css"
    media="(prefers-color-scheme: dark)"
  />
  <script src="https://cdn.jsdelivr.net/npm/flatpickr" is:inline defer></script>

  <!-- Booking behavior -->
  <script src="/js/contact.js" is:inline type="module"></script>
</Base>
