---
import Photo from '../../components/Photo.astro';
import Base from "../../layouts/Base.astro";
import "../../../public/styles/services.css";
const page = {
  title: "Practical Home Organisation in Shepparton | HomeOrg",
  description: "A function-based organising method using macro and micro containers, traffic paths, and reach analysis."
};
---
<Base {...page} canonical="https://homeorg.com.au/services/technical-approach">
  <section class="container services-hero">
    <h1>Technical Approach</h1>
    <p class="lead">A function-based organising method using macro and micro containers, traffic paths, and reach analysis.</p>

    <div class="tabs" hidden>
      <button class="tab is-active" data-target="kitchen">Kitchen</button>
      <button class="tab" data-target="wardrobe">Wardrobe</button>
      <button class="tab" data-target="office">Home Office</button>
    </div>

    <div class="tab-panels">
      <div id="kitchen" class="tab-panel is-active">
        <Photo src="/images/services/technical.png" alt="Organised kitchen" />
        <h2>Kitchen: meal prep made simple</h2>
        <ul class="checklist">
          <li>Zone-based cupboards (baking, pantry, snacks).</li>
          <li>Clear containers with easy labels.</li>
          <li>Quick inventory system to avoid double-buying.</li>
        </ul>
      </div>
      <div id="wardrobe" class="tab-panel">
        <Photo src="/images/services/technical.png" alt="Organised wardrobe" />
        <h2>Wardrobe: dress without stress</h2>
        <ul class="checklist">
          <li>Capsule wardrobe categories.</li>
          <li>Slim hangers to maximise space.</li>
          <li>Donation bag always ready.</li>
        </ul>
      </div>
      <div id="office" class="tab-panel">
        <Photo src="/images/services/technical.png" alt="Organised office" />
        <h2>Home Office: focus restored</h2>
        <ul class="checklist">
          <li>Cable management solutions.</li>
          <li>Simple filing and digital backups.</li>
          <li>Decluttered desktop, calming vibe.</li>
        </ul>
      </div>
    </div>

    <div class="panel">
      <h3>What you get</h3>
      <ul class="pill-list">
        <li>Tailored storage systems</li>
        <li>Decluttering guidance</li>
        <li>Daily habit tips</li>
      </ul>
      <p><a class="btn" href="/contact">Book your organising session</a></p>
    </div>
    <p><a href="/services">All services</a> &middot; <a href="/gallery">See before &amp; after results</a> &middot; <a href="/4c-steps-approach">Our 4Cs method</a></p>
  </section>

  <script src="/js/service-tabs.js" is:inline defer></script>
</Base>
