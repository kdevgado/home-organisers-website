---
import Photo from '../../components/Photo.astro';
import Base from "../../layouts/Base.astro";
import "../../../public/styles/services.css";
const page = {
  title: "Household Systems & Goal Setting | HomeOrg",
  description: "Designing organised spaces that reduce friction, improve focus, and support your daily and long-term goals."
};
---
<Base {...page} canonical="https://homeorg.com.au/services/goal-setting">
  <section class="container services-hero">
    <h1>Goal - Setting</h1>
    <p class="lead">Designing organised spaces that reduce friction, improve focus, and support your daily and long-term goals.</p>

    <div class="tabs" hidden>
      <button class="tab is-active" data-target="common">Common Areas</button>
      <button class="tab" data-target="kitchen">Shared Kitchen</button>
      <button class="tab" data-target="storage">Personal Storage</button>
    </div>

    <div class="tab-panels">
      <div id="common" class="tab-panel is-active">
        <Photo src="/images/services/goal-setting.png" alt="Shared living space" />
        <h2>Common Areas: reduce friction</h2>
        <ul class="checklist">
          <li>Neutral décor for inclusivity.</li>
          <li>Clear schedules for cleaning duties.</li>
          <li>Defined shared vs personal zones.</li>
        </ul>
      </div>
      <div id="kitchen" class="tab-panel">
        <Photo src="/images/services/goal-setting.png" alt="Shared kitchen" />
        <h2>Shared Kitchen: clear boundaries</h2>
        <ul class="checklist">
          <li>Labelled shelves for each person.</li>
          <li>Shared staples vs personal groceries.</li>
          <li>Rotating fridge clean-outs.</li>
        </ul>
      </div>
      <div id="storage" class="tab-panel">
        <Photo src="/images/services/goal-setting.png" alt="Personal storage" />
        <h2>Personal Storage: privacy respected</h2>
        <ul class="checklist">
          <li>Lockable boxes or cupboards.</li>
          <li>Colour-coded baskets.</li>
          <li>Easy access for quick tidying.</li>
        </ul>
      </div>
    </div>

    <div class="panel">
      <h3>What you get</h3>
      <ul class="pill-list">
        <li>Conflict-free systems</li>
        <li>Fair sharing solutions</li>
        <li>Peaceful home balance</li>
      </ul>
      <p><a class="btn" href="/contact">Book a homeshare setup</a></p>
    </div>
    <p><a href="/services">All services</a> &middot; <a href="/gallery">See before &amp; after results</a> &middot; <a href="/4c-steps-approach">Our 4Cs method</a></p>
  </section>

  <script src="/js/service-tabs.js" is:inline defer></script>
</Base>
