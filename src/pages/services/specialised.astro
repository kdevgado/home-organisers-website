---
import Photo from '../../components/Photo.astro';
import Base from "../../layouts/Base.astro";
import "../../../public/styles/services.css";
const page = {
  title: "Specialised Needs Support - Shepparton Home Organising",
  description: "Gentle, practical setups that support accessibility, independence, and specialised household needs."
};
---
<Base {...page} canonical="https://homeorg.com.au/services/specialised">
  <section class="container services-hero">
    <h1>Specialised Needs Support</h1>
    <p class="lead">Gentle, practical setups that support accessibility, independence, and specialised household needs.</p>

    <div class="tabs" hidden>
      <button class="tab is-active" data-target="prep">Pre-Move Prep</button>
      <button class="tab" data-target="packing">Packing</button>
      <button class="tab" data-target="setup">New Home Setup</button>
    </div>

    <div class="tab-panels">
      <div id="prep" class="tab-panel is-active">
        <Photo src="/images/services/specialised.png" alt="Pre-move preparation" />
        <h2>Pre-Move: declutter first</h2>
        <ul class="checklist">
          <li>Sort and donate before packing.</li>
          <li>Label boxes by room.</li>
          <li>Essentials bag packed separately.</li>
        </ul>
      </div>
      <div id="packing" class="tab-panel">
        <Photo src="/images/services/specialised.png" alt="Packing boxes" />
        <h2>Packing: smart & efficient</h2>
        <ul class="checklist">
          <li>Protect fragile items properly.</li>
          <li>Colour-coded labels by room.</li>
          <li>Moving-day survival kit ready.</li>
        </ul>
      </div>
      <div id="setup" class="tab-panel">
        <Photo src="/images/services/specialised.png" alt="New home setup" />
        <h2>Setup: settle in fast</h2>
        <ul class="checklist">
          <li>Unpack essentials first.</li>
          <li>Arrange furniture with flow in mind.</li>
          <li>Organise storage from the start.</li>
        </ul>
      </div>
    </div>

    <div class="panel">
      <h3>What you get</h3>
      <ul class="pill-list">
        <li>Decluttering before the move</li>
        <li>Efficient packing systems</li>
        <li>Quick new-home organisation</li>
      </ul>
      <p><a class="btn" href="/contact">Book moving support</a></p>
    </div>
    <p><a href="/services">All services</a> &middot; <a href="/gallery">See before &amp; after results</a> &middot; <a href="/4c-steps-approach">Our 4Cs method</a></p>
  </section>

  <script src="/js/service-tabs.js" is:inline defer></script>
</Base>
