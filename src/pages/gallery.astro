---
import Photo from '../components/Photo.astro';
import Base from "../layouts/Base.astro";
import BeforeAfterComponent from "../components/BeforeAfter.astro";
---

<Base title="Before & After | Home Organisers Australia" description="Explore HomeOrg's existing pantry, kitchen, storage and house staging projects. See practical home organising results and enquire about your own space.">
  <section class="container services-hero">
    <h1>Gallery</h1>
    <p>
      <strong>Real homes. Real results.</strong> Here's a peek at the kind of change
      simple systems can make.
    </p>
    <div class="before-after-intro">
      <p class="featured-video__kicker">Before & After</p>
      <h2>Practical transformations</h2>
      <p>
        Small changes, clearer zones, and systems that make the space easier to keep tidy.
      </p>
    </div>

    <div class="ba-grid">
      <BeforeAfterComponent
        before="/images/gallery/before-after/pantry before.jpg"
        after="/images/gallery/before-after/pantry.jpg"
        alt="Pantry organised with labelled containers"
        title="Pantry reset"
        description="Labels and clear containers make everyday items easier to see and reach."
        labelBefore="Before"
        labelAfter="After"
        start={55}
      />

      <BeforeAfterComponent
        before="/images/gallery/before-after/pantry_corner_before2.jpg"
        after="/images/gallery/before-after/pantry_corner.jpg"
        alt="Pantry organised with labelled containers"
        title="Corner pantry"
        description="A busy corner becomes calmer with grouped categories and better shelf flow."
        labelBefore="Before"
        labelAfter="After"
        start={55}
      />

      <BeforeAfterComponent
        before="/images/gallery/before-after/kitchen_before.png"
        after="/images/gallery/before-after/kitchen_after.jpg"
        alt="Kitchen bench and storage area after organising"
        title="Kitchen surfaces"
        description="Benches and storage zones are cleared so the room feels lighter and easier to use."
        labelBefore="Before"
        labelAfter="After"
        start={50}
      />

      <BeforeAfterComponent
        before="/images/gallery/before-after/kitchen2_before.png"
        after="/images/gallery/before-after/kitchen2_after.jpg"
        alt="Kitchen storage area after organising"
        title="Kitchen storage"
        description="A more intentional layout helps the essentials sit where they naturally belong."
        labelBefore="Before"
        labelAfter="After"
        start={50}
      />

      <BeforeAfterComponent
        before="/images/gallery/before-after/kitchen3_before.png"
        after="/images/gallery/before-after/kitchen3_after.jpg"
        alt="Kitchen area after organising"
        title="Kitchen refresh"
        description="The finished space keeps the practical items close while reducing visual clutter."
        labelBefore="Before"
        labelAfter="After"
        start={50}
      />
    </div>

    <section class="featured-video gallery-section">
      <div class="featured-video__shell">
        <div class="featured-video__header video-highlight__header">
          <div>
            <p class="featured-video__kicker">Featured Transformation</p>
            <h2 class="featured-video__title">Home Transformation Videos</h2>
            <p class="featured-video__desc">
              A quick look at how we create calm, functional spaces with simple systems.
            </p>
          </div>
          <a
            class="video-highlight__channel"
            href="https://www.youtube.com/@HomeOrgAustralia"
            target="_blank"
            rel="noopener noreferrer"
          >
            Visit YouTube channel
          </a>
        </div>

        <button
          class="video-thumb featured-video__thumb"
          type="button"
          data-type="youtube"
          data-id="Yh1ooi1RGJc"
          aria-label="Play house staging video"
        >
          <Photo src="/images/gallery/video-thumb.jpg" alt="Play house staging video" />
          <span class="featured-video__play" aria-hidden="true">
            <span class="featured-video__playIcon">&#9658;</span>
            <span class="featured-video__playText">Play video</span>
          </span>
        </button>
      </div>
    </section>

    <div class="gallery-intro">
      <p class="featured-video__kicker">Gallery</p>
      <h2 class="gallery-heading">House Staging</h2>
    </div>

    <div class="gallery">
      <a class="gallery-photo" href="/images/gallery/mickelham/4.jpg" aria-label="View house staging transformation"><Photo src="/images/gallery/mickelham/4.jpg" alt="House staging transformation" /></a>
      <a class="gallery-photo" href="/images/gallery/mickelham/5.jpg" aria-label="View house staging transformation"><Photo src="/images/gallery/mickelham/5.jpg" alt="House staging transformation" /></a>
      <a class="gallery-photo" href="/images/gallery/mickelham/1.jpg" aria-label="View house staging transformation"><Photo src="/images/gallery/mickelham/1.jpg" alt="House staging transformation" /></a>
      <a class="gallery-photo" href="/images/gallery/mickelham/2.jpg" aria-label="View house staging transformation"><Photo src="/images/gallery/mickelham/2.jpg" alt="House staging transformation" /></a>
      <a class="gallery-photo" href="/images/gallery/mickelham/3.jpg" aria-label="View house staging transformation"><Photo src="/images/gallery/mickelham/3.jpg" alt="House staging transformation" /></a>

      <a class="gallery-photo" href="/images/gallery/mickelham/6.jpg" aria-label="View house staging transformation"><Photo src="/images/gallery/mickelham/6.jpg" alt="House staging transformation" /></a>
      <a class="gallery-photo" href="/images/gallery/mickelham/7.jpg" aria-label="View house staging transformation"><Photo src="/images/gallery/mickelham/7.jpg" alt="House staging transformation" /></a>
      <a class="gallery-photo" href="/images/gallery/mickelham/8.jpg" aria-label="View house staging transformation"><Photo src="/images/gallery/mickelham/8.jpg" alt="House staging transformation" /></a>
      <a class="gallery-photo" href="/images/gallery/mickelham/9.jpg" aria-label="View house staging transformation"><Photo src="/images/gallery/mickelham/9.jpg" alt="House staging transformation" /></a>
      <a class="gallery-photo" href="/images/gallery/mickelham/10.jpg" aria-label="View house staging transformation"><Photo src="/images/gallery/mickelham/10.jpg" alt="House staging transformation" /></a>
      <a class="gallery-photo" href="/images/gallery/mickelham/11.jpg" aria-label="View house staging transformation"><Photo src="/images/gallery/mickelham/11.jpg" alt="House staging transformation" /></a>

      <a class="gallery-photo" href="/images/gallery/sharehouse/1.jpg" aria-label="View closet organisation"><Photo src="/images/gallery/sharehouse/1.jpg" alt="Closet organisation" /></a>
      <a class="gallery-photo" href="/images/gallery/sharehouse/2.jpg" aria-label="View closet organisation"><Photo src="/images/gallery/sharehouse/2.jpg" alt="Closet organisation" /></a>
      <a class="gallery-photo" href="/images/gallery/sharehouse/3.jpg" aria-label="View closet organisation"><Photo src="/images/gallery/sharehouse/3.jpg" alt="Closet organisation" /></a>
      <a class="gallery-photo" href="/images/gallery/sharehouse/4.jpg" aria-label="View closet organisation"><Photo src="/images/gallery/sharehouse/4.jpg" alt="Closet organisation" /></a>
      <a class="gallery-photo" href="/images/gallery/sharehouse/5.jpg" aria-label="View closet organisation"><Photo src="/images/gallery/sharehouse/5.jpg" alt="Closet organisation" /></a>
      <a class="gallery-photo" href="/images/gallery/sharehouse/6.jpg" aria-label="View closet organisation"><Photo src="/images/gallery/sharehouse/6.jpg" alt="Closet organisation" /></a>
      <a class="gallery-photo" href="/images/gallery/sharehouse/7.jpg" aria-label="View closet organisation"><Photo src="/images/gallery/sharehouse/7.jpg" alt="Closet organisation" /></a>

      <a class="gallery-photo" href="/images/gallery/gladstone/1.jpg" aria-label="View house staging transformation"><Photo src="/images/gallery/gladstone/1.jpg" alt="House staging transformation" /></a>
      <a class="gallery-photo" href="/images/gallery/gladstone/2.jpg" aria-label="View house staging transformation"><Photo src="/images/gallery/gladstone/2.jpg" alt="House staging transformation" /></a>
      <a class="gallery-photo" href="/images/gallery/gladstone/3.jpg" aria-label="View house staging transformation"><Photo src="/images/gallery/gladstone/3.jpg" alt="House staging transformation" /></a>
      <a class="gallery-photo" href="/images/gallery/gladstone/4.jpg" aria-label="View house staging transformation"><Photo src="/images/gallery/gladstone/4.jpg" alt="House staging transformation" /></a>
    </div>

    <dialog id="lightbox" class="lightbox" aria-label="Project photos and video">
      <button type="button" class="close" aria-label="Close gallery">&times;</button>
      <div class="lightbox-content" id="lightboxContent"></div>
      <p id="gallery-status" class="gallery-status" aria-live="polite"></p>
      <button type="button" class="prev" aria-label="Previous project">&#10094;</button>
      <button type="button" class="next" aria-label="Next project">&#10095;</button>
    </dialog>

    <p class="muted">
      More transformations coming soon. Each session focuses on practical,
      maintainable changes - not show-home perfection.
    </p>
    <p>
      <a class="btn" href="/contact"
        >Be the next transformation - book your session</a
      >
    </p>
  </section>

  <script src="/js/gallery.js" is:inline type="module"></script>

<style>
  .before-after-intro {
    max-width: 760px;
    margin: 2.25rem auto 1.25rem;
    text-align: center;
  }

  .before-after-intro h2 {
    margin: 0 0 .45rem;
  }

  .before-after-intro p:last-child {
    margin: 0 auto;
    color: var(--ink-soft);
  }

  .ba-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.1rem;
    max-width: 1180px;
    margin-inline: auto;
  }

  .gallery-section {
    margin-top: 3.5rem;
  }

  .video-highlight__header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .video-highlight__channel {
    align-self: start;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: .7rem 1rem;
    border-radius: 999px;
    background: #fff;
    color: rgba(30, 120, 80, .95);
    border: 1px solid rgba(30, 120, 80, .22);
    box-shadow: 0 10px 24px rgba(0,0,0,.08);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: transform .2s ease, box-shadow .2s ease;
  }

  .video-highlight__channel:hover {
    transform: translateY(-1px);
    box-shadow: 0 14px 30px rgba(0,0,0,.11);
  }

  .gallery-intro {
    max-width: 760px;
    margin: 3rem auto 1rem;
    text-align: center;
  }

  .gallery-heading {
    margin: 0;
  }

  @media (max-width: 850px) {
    .ba-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 700px) {
    .video-highlight__header {
      align-items: center;
      flex-direction: column;
      text-align: center;
    }

    .video-highlight__channel {
      align-self: center;
      white-space: normal;
    }
  }
</style>

</Base>
