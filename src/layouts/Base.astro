---
import Photo from '../components/Photo.astro';
interface Props { title?: string; description?: string; canonical?: string; noindex?: boolean; }
const {
  title = 'Professional Home Organising - Shepparton & Goulburn Valley',
  description = 'Warm, non-judgemental decluttering and home organising for Shepparton and the Goulburn Valley. Simple systems, local care, and lasting calm.',
  canonical, noindex = false,
} = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonicalURL = canonical || new URL(pathname, Astro.site).href;
const showCTA = pathname !== '/contact' && pathname !== '/404';
const services = [
  ['/services/space-efficiency', 'Space Efficiency'], ['/services/specialised', 'Specialised Needs Support'],
  ['/services/technical-approach', 'Technical Approach'], ['/services/fitstyle', 'Fit for purpose & style'], ['/services/goal-setting', 'Goal Setting'],
];
const links = [['/', 'Home'], ['/services', 'Services'], ['/about', 'About'], ['/4c-steps-approach', '4Cs Method'], ['/gallery', 'Before & After'], ['/follow-us', 'Follow Us']];
const business = {
  '@context': 'https://schema.org', '@type': 'LocalBusiness', '@id': 'https://homeorg.com.au/#business',
  name: 'Home Organisers Australia', alternateName: 'HomeOrg', url: 'https://homeorg.com.au/',
  telephone: '+61415640352', email: 'roweedelgado@homeorg.com.au',
  image: 'https://homeorg.com.au/images/your-home-organisers3.jpg', logo: 'https://homeorg.com.au/images/logo_transparent.png',
  areaServed: ['Shepparton', 'Greater Shepparton', 'Goulburn Valley', 'Northern Victoria'],
  sameAs: ['https://www.facebook.com/HomeOrgAustralia', 'https://www.instagram.com/homeorg.com.au/'],
};
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" href="/images/logo.jpg" type="image/jpeg" />
    <link rel="apple-touch-icon" href="/images/logo_transparent.png" />
    <meta name="theme-color" content="#0f766e" />
    <link rel="stylesheet" href="/styles/global.css" />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:site_name" content="Home Organisers Australia" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content="https://homeorg.com.au/images/your-home-organisers3.jpg" />
    <meta property="og:image:alt" content="John and Rowee Delgado, Home Organisers Australia" />
    <meta name="twitter:card" content="summary_large_image" />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(business).replace(/</g, '\\u003c')} />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="logo" aria-label="Home Organisers Australia home"><Photo src="/images/logo_transparent.png" alt="Home Organisers Australia" class="logo-img" width={240} loading="eager" /></a>
        <nav class="nav nav-desktop" aria-label="Main navigation">
          {links.map(([href, label]) => href === '/services' ? (
            <div class="dropdown"><a href={href} aria-current={pathname === href ? 'page' : undefined}>{label}</a><div class="dropdown-menu">{services.map(([url, name]) => <a href={url}>{name}</a>)}</div></div>
          ) : <a href={href} aria-current={pathname === href ? 'page' : undefined}>{label}</a>)}
          <a class="btn" href="/contact" aria-current={pathname === '/contact' ? 'page' : undefined}>Contact us</a>
        </nav>
        <button class="menu-toggle" aria-controls="mobile-nav" aria-expanded="false" aria-label="Open menu"><span class="menu-bars" aria-hidden="true"></span></button>
      </div>
    </header>
    <main class="site-main" id="main-content" tabindex="-1"><slot /></main>
    {showCTA && <a class="floating-cta" href="/contact">Contact us</a>}
    <footer class="site-footer">
      <div class="container">
        <p><strong>Based in Shepparton, Victoria.</strong> Serving Greater Shepparton, the Goulburn Valley and Northern Victoria.</p>
        <p>Member of the Institute of Professional Organisers (IOPO) Australia &amp; New Zealand</p>
        <p><a href="mailto:roweedelgado@homeorg.com.au">roweedelgado@homeorg.com.au</a></p>
        <nav class="footer-nav" aria-label="Footer navigation">{links.map(([href, label]) => <a href={href}>{label}</a>)}<a href="/#testimonials">Testimonials</a><a href="/contact">Contact</a></nav>
        <p><a href="https://www.facebook.com/HomeOrgAustralia">Facebook</a> · <a href="https://www.instagram.com/homeorg.com.au/">Instagram</a></p>
        <div class="social-feed"><iframe title="Home Organisers Australia Facebook updates" src="https://www.facebook.com/plugins/page.php?href=https://www.facebook.com/HomeOrgAustralia&amp;tabs=timeline&amp;width=500&amp;height=600&amp;small_header=false&amp;adapt_container_width=true&amp;hide_cover=false&amp;show_facepile=true" width="500" height="600" loading="lazy"></iframe></div>
        <p class="small">© {new Date().getFullYear()} Home Organisers Australia</p>
      </div>
    </footer>
    <div class="mobile-overlay" data-close></div>
    <nav id="mobile-nav" class="nav-mobile" aria-label="Mobile navigation" aria-hidden="true" inert>
      <div class="mobile-header"><span class="mobile-title">Menu</span><button class="menu-close" aria-label="Close menu" data-close><span class="menu-cross" aria-hidden="true"></span></button></div>
      <ul class="mobile-list">{links.map(([href, label]) => <li class="mobile-item"><a href={href} aria-current={pathname === href ? 'page' : undefined}>{label}</a></li>)}<li class="mobile-item"><a href="/#testimonials">Testimonials</a></li><li class="mobile-item cta"><a class="btn" href="/contact">Contact us</a></li></ul>
    </nav>
    <script src="/js/navigation.js" is:inline defer></script>
    <noscript><style>.menu-toggle{display:none}.nav-desktop{display:flex;flex-wrap:wrap}.header-inner{flex-wrap:wrap}.nav a{margin:.4rem}</style></noscript>
  </body>
</html>
