# Server-only values. Set in Netlify's environment settings; never use PUBLIC_ prefixes.
GMAIL_USER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Optional availability endpoint (not used by the enquiry form).
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_CALENDAR_ID=

# Legacy SMTP enquiry endpoint, if still used by an external client.
MAIL_FROM=
MAIL_TO=
GMAIL_HOST=smtp.gmail.com
GMAIL_PORT=465
GMAIL_SECURE=true
GMAIL_PASS=
